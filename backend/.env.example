# Local development only. Generate a strong random SECRET_KEY for this ignored
# .env file. Never use the placeholder in a deployed environment.
APP_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-this-local-development-secret
DATABASE_URL=sqlite:///don_prosy.db

# Use "smtp" for authenticated SMTP (Gmail supports an app password), or
# "resend" with a verified sender and API key. "console" is development-only.
AUTH_EMAIL_MODE=smtp
RESEND_API_KEY=
PUBLIC_APP_URL=http://localhost:5173

# SMTP is also used for OTPs when AUTH_EMAIL_MODE=smtp.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_DEFAULT_SENDER=
MAIL_SENDER_NAME=STEER
MAIL_FROM=

# Optional Stage 5 AI provider configuration. Keep the key on the backend only.
# Values are intentionally blank; the provider will remain unavailable until
# the instructor-provided API documentation and credentials are supplied.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_API_FORMAT=openai_chat
AI_CHAT_PATH=/chat/completions
AI_AUTH_SCHEME=Bearer
AI_TIMEOUT_SECONDS=30
AI_MAX_CONTEXT_MESSAGES=12

# Local development may use process-local limits. Production requires shared
# storage (for example a managed Redis-compatible endpoint).
RATELIMIT_STORAGE_URI=memory://
