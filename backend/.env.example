# Local development only. Generate a strong random SECRET_KEY for this ignored
# .env file. Never use the placeholder in a deployed environment.
APP_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-this-local-development-secret
DATABASE_URL=sqlite:///don_prosy.db

# Required to deliver authentication OTPs through Resend. Use a sender address
# verified with Resend. Never commit API keys.
RESEND_API_KEY=
PUBLIC_APP_URL=http://localhost:5173

# Optional SMTP settings for non-OTP account notifications.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_DEFAULT_SENDER=
MAIL_SENDER_NAME=STEER
MAIL_FROM=

# Local development may use process-local limits. Production requires shared
# storage (for example a managed Redis-compatible endpoint).
RATELIMIT_STORAGE_URI=memory://
